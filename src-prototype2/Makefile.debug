# Makefile for Pirate Kingdoms - Test Build

CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -I./core -I./adapters/debug -I./tests
LDFLAGS =

CORE_SRC = core/ship.c core/calendar_engine.c core/map_engine.c
ADAPTER_SRC = adapters/debug/debug_adapter.c
TEST_SRC = tests/test_core.c
TEST_MAP_SRC = tests/test_map.c

CORE_OBJ = $(CORE_SRC:.c=.o)
ADAPTER_OBJ = $(ADAPTER_SRC:.c=.o)
TEST_OBJ = $(TEST_SRC:.c=.o)
TEST_MAP_OBJ = $(TEST_MAP_SRC:.c=.o)

TEST_BIN = test_runner
TEST_MAP_BIN = test_map
DEBUG_BIN = debug_repl
TARGETS = $(TEST_BIN) $(TEST_MAP_BIN) $(DEBUG_BIN)

all: $(TARGETS)

$(TEST_BIN): $(CORE_OBJ) $(ADAPTER_OBJ) $(TEST_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

$(TEST_MAP_BIN): $(CORE_OBJ) $(TEST_MAP_OBJ)
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

$(DEBUG_BIN): $(CORE_OBJ) $(ADAPTER_OBJ) debug_main.o
	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

test: $(TEST_BIN) $(TEST_MAP_BIN)
	./$(TEST_BIN)
	./$(TEST_MAP_BIN)

debug: $(DEBUG_BIN)
	./$(DEBUG_BIN)

clean:
	rm -f $(CORE_OBJ) $(ADAPTER_OBJ) $(TEST_OBJ) $(TEST_MAP_OBJ) debug_main.o $(TARGETS)

.PHONY: all test debug clean
